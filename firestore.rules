rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each family's data sits under a long random code that only the family's devices know.
    // Nothing else in the database can be read or written.
    match /families/{family}/weeks/{week} {
      allow get, list: if family.size() >= 20;
      allow create, update: if family.size() >= 20
        && week.matches('(matilda|brooks)-[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.keys().hasOnly(['days'])
        && request.resource.data.days is map;
    }
  }
}
